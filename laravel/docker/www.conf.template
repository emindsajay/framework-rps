[global]
daemonize = no
error_log = /proc/self/fd/2

[www]
user = www-data
group = www-data
listen = 127.0.0.1:9000
listen.backlog = 4096
pm = static
pm.max_children = __APP_CONCURRENCY__
pm.max_requests = 0
clear_env = no
catch_workers_output = yes
decorate_workers_output = no
request_terminate_timeout = 30s
